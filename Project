def get_device_information():

    # Get basic device information
    system_name = platform.node()
    system_type = platform.system() + " " + platform.release()

    # Get IP address
    try:
        network = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        network.connect(("8.8.8.8", 80))
        ipaddress = network.getsockname()[0]
        network.close()
    except OSError:
        ipaddress = "Unknown"

    # Get manufacturer, model and serial number using Windows
    try:
        command = """
        $cs = Get-CimInstance Win32_ComputerSystem
        $bios = Get-CimInstance Win32_BIOS
        [pscustomobject]@{
            Manufacturer = $cs.Manufacturer
            Model = $cs.Model
        } | ConvertTo-Json -Compress
        """

        result = subprocess.run(
            ["powershell", "-NoProfile", "-Command", command],
            capture_output=True,
            text=True,
            check=True
        )

        device_data = json.loads(result.stdout)

        manufacturer = device_data["Manufacturer"]
        model = device_data["Model"]

    except (OSError,subprocess.SubprocessError, json.JSONDecodeError, KeyError):
        manufacturer = "Unknown"
        model = "Unknown"

    return (
        system_name,
        model,
        manufacturer,
        system_type,
        ipaddress
    )

