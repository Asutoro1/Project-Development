import sqlite3

def create_database():
    #Database and table creation
    mydb = sqlite3.connect("AssetTracking.db")

    cursor = mydb.cursor()

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS Assets( 
            asset_id INTEGER PRIMARY KEY AUTOINCREMENT,
            system_name TEXT NOT NULL,
            model TEXT,
            manufacturer TEXT,
            system_type TEXT,
            ipaddress TEXT
        )
    """)
    mydb.commit()
    mydb.close()
    print("Database created!")

def display_menu():
    #This is dysplaying what all the options are.
    print("Welcome to the Scottish Glen Asset tracking system")
    print("What option would you like to do")
    print()
    print("1. Add a new asset")
    print("2. View all assets")
    print("3. Edit an asset")
    print("4. Delete an asset")
    print("5. Exit")
    print()
    print("Please select an option from the above menu")

def select_option():
    #This is getting the users choice of what they would like to do
    valid_option = False
    while not valid_option:
        try:
            choice = int(input("Option Selected: "))
            if choice in (1,2,3,4,5):
                valid_option = True
            else:
                print("please enter a valid option")
        except ValueError:
            print("Please enter a valid option")
    return choice
def adding_asset():
    #Function that will be used to add a new assets to the database.
    
    system_name = input("Please enter the asset name you want to track:")
    model = input("Please enter the model of the asset:")
    manufacturer = input("Please enter the manufacturer of that the asset:")
    system_type = input("Please enter the type of asset:")
    ipaddress = input("Please enter the IP address of the asset:")
    with sqlite3.connect("AssetTracking.db") as mydb:
        cursor = mydb.cursor()
        cursor.execute("""
            INSERT INTO Assets
            (system_name, model, manufacturer, system_type, ipaddress)
            VALUES(?, ?, ?, ?, ?)
        """, (system_name, model, manufacturer, system_type, ipaddress))
    print(f"Asset tracked: {system_name} - {model} - {manufacturer} - {system_type} - {ipaddress}")
def view_assets():
    #This function will show all the asset data currently collected
    with sqlite3.connect("AssetTracking.db") as mydb:
        cursor = mydb.cursor()
        cursor.execute("SELECT * FROM Assets")
        assets = cursor.fetchall()
    if not assets:
        print("No assets found.")
        return
    for asset in assets:
        print(asset)
