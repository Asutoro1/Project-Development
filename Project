                """, (system_name, model, manufacturer, system_type, ipaddress))
        print("Asset data successfully changed.")
def delete_asset():
    asset_id = input("Enter the asset ID that you would like to edit:")
    
    with sqlite3.connect("AssetTracking.db") as mydb:
        cursor = mydb.cursor()

        cursor.execute("""
            DELETE FROM Assets WHERE asset_id = ?
        """, (asset_id))

        if cursor.rowcount == 0:
            print("Asset not found.")
        else:
            print ("Asset has been deleted.") 

def main():
    create_database()

    display_menu()
    choice = select_option()
